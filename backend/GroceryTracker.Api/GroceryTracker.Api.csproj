<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GroceryTracker.Core\GroceryTracker.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SpaRoot>..\..\frontend\</SpaRoot>
  </PropertyGroup>

  <!--
    Publish-only (not part of `dotnet build`, so ordinary backend dev stays fast):
    builds the React app and drops its output straight into the publish
    directory's wwwroot. Kestrel serves it via UseStaticFiles/MapFallbackToFile
    in Program.cs — same-origin as the API, no separate frontend deploy step.
  -->
  <Target Name="PublishFrontend" BeforeTargets="Publish">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(SpaRoot)dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
